# ==============================================================================
# SyncTone — Environment Configuration Template
# ==============================================================================

# Node / Environment
NODE_ENV=development
PORT=4000

# Security & Authentication (Change in production!)
JWT_SECRET=synctone_super_secret_jwt_key_2026_dev_mode
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 1. PostgreSQL 16 (Authoritative Core & Jobs Queue)
# ------------------------------------------------------------------------------
POSTGRES_USER=synctone_user
POSTGRES_PASSWORD=synctone_pass
POSTGRES_DB=synctone
POSTGRES_PORT=5432
DATABASE_URL=postgresql://synctone_user:synctone_pass@localhost:5432/synctone

# ------------------------------------------------------------------------------
# 2. MongoDB 7.0 (Raw Chapters & Segment Timeline Documents)
# ------------------------------------------------------------------------------
MONGO_USER=synctone_user
MONGO_PASSWORD=synctone_pass
MONGO_DB=synctone
MONGO_PORT=27017
MONGO_URI=mongodb://synctone_user:synctone_pass@localhost:27017/synctone?authSource=admin

# ------------------------------------------------------------------------------
# 3. OpenStack Swift (Distributed Object Storage for .opus & Covers)
# ------------------------------------------------------------------------------
# Default credentials for local openstackswift/saio or bouncestorage/swift-aio
SWIFT_PORT=8080
SWIFT_AUTH_URL=http://localhost:8080/auth/v1.0
SWIFT_USERNAME=test:tester
SWIFT_KEY=testing
SWIFT_CONTAINER_AUDIO=novel-chapters
SWIFT_CONTAINER_COVERS=novel-covers

# ------------------------------------------------------------------------------
# 4. Python Worker & Kokoro-ONNX Neural Engine
# ------------------------------------------------------------------------------
WORKER_ID=synctone-worker-1
WORKER_POLL_INTERVAL_SEC=3
PCM_CACHE_DIR=./novel-audio-synthesizer/kokoro-tts-backend/output/pcm_cache
KOKORO_MODEL_PATH=./novel-audio-synthesizer/kokoro-tts-backend/models_cache/kokoro-v0_19.onnx
KOKORO_VOICES_PATH=./novel-audio-synthesizer/kokoro-tts-backend/models_cache/voices.bin
